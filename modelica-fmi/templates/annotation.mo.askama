annotation (
    Icon(
      coordinateSystem(preserveAspectRatio=false, extent={ { {{ -(icon_width / 2.0) }}, {{ -(icon_height / 2.0) }} }, { {{ icon_width / 2.0 }}, {{ icon_height / 2.0 }} } }),
      graphics={
        Rectangle(
          extent={ { {{ -(icon_width / 2.0) }}, {{ -(icon_height / 2.0) }} }, { {{ icon_width / 2.0 }}, {{ icon_height / 2.0 }} } },
          lineColor={0, 0, 127},
          fillColor={255, 255, 255},
          fillPattern=FillPattern.Solid
        ),
        Bitmap(
          visible=not showLabels,
          extent={ {-90, -90}, {90, 90} },
          fileName="modelica://FMI/Resources/Images/FMU_bare.svg"
        ),
{%- for label in port_labels %}
        {{ label }},
{%- endfor %}
        Text(
          extent={ {0, {{ (icon_height / 2.0) + 50.0 }} }, {0, {{ (icon_height / 2.0) + 10.0 }} } },
          textString="%name",
          textColor={0,0,255}
        )
      }
    ),
    Diagram(coordinateSystem(preserveAspectRatio=false, extent={ { {{ -(icon_width / 2.0) }}, {{ -(icon_height / 2.0) }} }, { {{ icon_width / 2.0 }}, {{ icon_height / 2.0 }} } })),
{%- if let Some(default_experiment) = model_description.defaultExperiment && let Some(stop_time) = default_experiment.stopTime %}
    experiment(StopTime={{ stop_time }}),
{%- endif %}
    uses(FMI(version="{{ version }}")),
    Documentation(info="<html><p>For more information open the FMU's <a href=\"{{ unzipdir }}/documentation/index.html\">original documentation</a>.</p></html>")
  );